<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>
    <title>Document</title>
</head>
<body>
    <%- include("./partials/nav") %>
    
    <div class="container" >
        <h1><%= blog.title%></h1>
        <img src=<%= blog.coverImageURL%> width="600px">
        <pre style="white-space: pre-wrap;"><%= blog.body%></pre>
        <div class="container mt-4">
        </div>
    </div>
    <div class="container mt-4">
        
        <img width="50px" src=<%=blog.createdBy.profileImageUrl%>>
       <p>Created By:  <%= blog.createdBy.fullName %></p>
    </div>

   

    <div class="container mt-4">
         <h2>Comments:<%= comments.length%></h2>
        <form action="/comment/<%= blog._id%>" method="post">
          
             <input type="text" name="comment" class="form-control" id="content">
         <button type="submit" class="btn btn-primary">submit</button>
    </div>


    
     <div class="container mt-4">
       
        <% comments.forEach(comment => { %>
         <div>
             <img width="50px" src=<%=comment.createdBy.profileImageUrl%>>
             <%= comment.createdBy.fullName%>
             <pre><%= comment.comment%></pre>
         </div>
        <% }) %>
    </div>
     <%- include("./partials/script") %>
</body>
</html>